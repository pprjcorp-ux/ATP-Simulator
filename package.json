{
  "name": "pluto-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "snapshot:import": "node scripts/import-pluto-snapshot.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "pluto:imessage-login": "node scripts/pluto-imessage-login-state.mjs",
    "pluto:imessage-login:summary": "node scripts/pluto-imessage-login-state.mjs --summary",
    "pluto:imessage-login:self-test": "node scripts/pluto-imessage-login-state.mjs --self-test",
    "pluto:apple-id:provision": "node scripts/pluto-apple-account-provision.mjs",
    "pluto:apple-id:credential": "node scripts/pluto-apple-id-credential.mjs",
    "pluto:apple-id:ready": "node scripts/pluto-apple-id-credential.mjs --check-ready-to-validate",
    "pluto:apple-id:handoff": "node scripts/pluto-apple-id-credential.mjs --prepare-account-flow",
    "pluto:apple-id:copy-email": "node scripts/pluto-apple-id-credential.mjs --copy-dedicated-email-to-clipboard",
    "pluto:apple-id:copy-phone": "node scripts/pluto-apple-id-credential.mjs --copy-verification-phone-to-clipboard",
    "pluto:apple-id:copy-password": "node scripts/pluto-apple-id-credential.mjs --restore-candidate-to-clipboard",
    "pluto:apple-id:update-password": "node scripts/pluto-apple-id-credential.mjs --update-candidate-password-from-stdin",
    "pluto:apple-id:update-password-from-clipboard": "node scripts/pluto-apple-id-credential.mjs --update-candidate-password-from-clipboard",
    "pluto:apple-id:clipboard": "node scripts/pluto-apple-id-credential.mjs --clipboard-status",
    "pluto:apple-id:submit-messages": "node scripts/pluto-apple-id-credential.mjs --submit-messages-login",
    "pluto:discord:status": "node scripts/pluto-discord-credential.mjs",
    "pluto:discord:dry-run": "node scripts/pluto-discord-credential.mjs --dry-run",
    "pluto:discord:self-test": "node scripts/pluto-discord-credential.mjs --self-test",
    "pluto:discord:invite-url": "node scripts/pluto-discord-credential.mjs --invite-url",
    "pluto:discord:install-from-stdin": "node scripts/pluto-discord-credential.mjs --install-from-stdin",
    "pluto:alerts:route": "node scripts/pluto-alert-router.mjs",
    "pluto:alerts:self-test": "node scripts/pluto-alert-router.mjs --self-test",
    "pluto:monitor": "node scripts/pluto-health-check.mjs --smoke; health=$?; node scripts/pluto-alert-router.mjs; route=$?; node scripts/import-pluto-snapshot.mjs; import=$?; if [ $health -ne 0 ]; then exit $health; fi; if [ $route -ne 0 ]; then exit $route; fi; exit $import",
    "pluto:monitor:self-test": "node scripts/pluto-health-check.mjs --self-test",
    "pluto:check": "node scripts/pluto-health-check.mjs --full",
    "pluto:sts": "node scripts/pluto-sts-turn.mjs",
    "pluto:sts:self-test": "node scripts/pluto-sts-turn.mjs --self-test --no-play --json",
    "pluto:sts:mobile": "node scripts/pluto-sts-mobile-server.mjs",
    "pluto:sts:mobile:start": "node scripts/pluto-sts-mobile-server.mjs --daemon --public-base-url ${PLUTO_STS_MOBILE_PUBLIC_URL:-http://127.0.0.1:8787/sts}",
    "pluto:sts:mobile:status": "node scripts/pluto-sts-mobile-server.mjs --status",
    "pluto:sts:mobile:stop": "node scripts/pluto-sts-mobile-server.mjs --stop",
    "pluto:sts:mobile:self-test": "node scripts/pluto-sts-mobile-server.mjs --self-test",
    "pluto:mira:turn": "node scripts/pluto-mira-bridge.mjs",
    "pluto:mira:self-test": "node scripts/pluto-mira-bridge.mjs --self-test",
    "pluto:codex:turn": "node scripts/pluto-codex-relay.mjs",
    "pluto:codex:self-test": "node scripts/pluto-codex-relay.mjs --self-test",
    "repair:native": "bash scripts/repair-native-bindings.sh"
  },
  "dependencies": {
    "lucide-react": "1.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vite": "6.4.3"
  }
}
