# Legacy iMessage audit only. Leave empty unless PLUTO_IMESSAGE_POLICY=active.
PLUTO_DEDICATED_APPLE_ID=
PLUTO_APPLE_ID_VERIFICATION_EMAIL=
PLUTO_APPLE_ID_VERIFICATION_PHONE=
PLUTO_FORBIDDEN_IMESSAGE_IDENTITIES=

# Discord DM smoke target. Set before running real Discord send/dry-run actions.
PLUTO_DISCORD_USER_ID=

# Optional public STS URL for iPhone/PWA. Use the Vite-prefixed value for UI builds.
PLUTO_STS_MOBILE_PUBLIC_URL=
VITE_PLUTO_STS_PUBLIC_URL=
